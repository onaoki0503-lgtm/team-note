# Optional. Development uses the Vite proxy at /api/ai.
# Production: HTTPS URL of the separately configured AI Worker, including /api/ai.
VITE_AI_WORKER_URL=

# Shared ideas only. Keep VITE_SUPABASE_* unset to keep the prototype dbService local.
# Browser-safe publishable key only; never a secret/service_role key.
VITE_TEAMNOTE_SUPABASE_URL=
VITE_TEAMNOTE_SUPABASE_PUBLISHABLE_KEY=
# AI Worker (production): also set worker secret SUPABASE_ANON_KEY to the same publishable key.
