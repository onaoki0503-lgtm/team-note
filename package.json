{
  "name": "team_note_ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc --ip 127.0.0.1 --port 8787",
    "worker:check": "tsc --project worker/tsconfig.json && wrangler deploy --dry-run --config worker/wrangler.jsonc --outdir /private/tmp/teamnote-worker-bundle",
    "test:worker": "node --experimental-strip-types --test tests/worker.test.ts",
    "test:browser": "playwright test",
    "test": "npm run test:ideas && npm run test:worker && npm run test:browser && npm run test:cloud",
    "test:ideas": "node --experimental-strip-types --test tests/idea-board.test.ts",
    "test:cloud": "playwright test --config playwright.cloud.config.ts",
    "test:public": "playwright test --config playwright.public.config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "lucide-react": "^1.52.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "read-excel-file": "9.3.12"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "4.151.1"
  }
}
